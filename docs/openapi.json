  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "local_start": {
            "type": "string",
            "format": "date",
            "title": "Local Start"
          },
          "local_end": {
            "type": "string",
            "format": "date",
            "title": "Local End"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "lease_token": {
            "type": "string",
            "format": "uuid",
            "title": "Lease Token"
          },
          "grouping_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Grouping Version"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Candidates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "local_start",
          "local_end",
          "run_id",
          "lease_token",
          "grouping_version",
          "candidates"
        ],
        "title": "Batch"
      },
      "Cache": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "lease_token": {
            "type": "string",
            "format": "uuid",
            "title": "Lease Token"
          },
          "event_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Event Ids"
          },
          "variants": {
            "items": {
              "type": "string",
              "enum": [
                "snapshot",
                "bbox",
                "clip"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Variants",
            "default": [
              "snapshot"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "lease_token",
          "event_ids"
        ],
        "title": "Cache"
      },
      "Candidate": {
        "properties": {
          "station_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
            "title": "Station Id"
          },
          "member_event_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Member Event Ids"
          },
          "pet_id": {
            "anyOf": [
              {
                "type": "string",
                "const": "coconut"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pet Id",
            "default": "coconut"
          },
          "identity_method": {
            "type": "string",
            "enum": [
              "single_pet_assumption",
              "unknown"
            ],
            "title": "Identity Method",
            "default": "single_pet_assumption"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "station_id",
          "member_event_ids"
        ],
        "title": "Candidate"
